<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:duplicateAssistant="clr-namespace:DuplicateAssistant"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="DuplicateAssistant.App">
    <Application.DataTemplates>
        <duplicateAssistant:ViewLocator/>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme/>
        <materialIcons:MaterialIconStyles/>

        <!-- Same spacing and placement for the progress bar on every page. -->
        <Style Selector="ProgressBar.pageProgress">
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </Application.Styles>
</Application>
