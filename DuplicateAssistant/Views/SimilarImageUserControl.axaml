<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DuplicateAssistant.ViewModels"
             xmlns:views="clr-namespace:DuplicateAssistant.Views"
             xmlns:controls="clr-namespace:DuplicateAssistant.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="DuplicateAssistant.Views.SimilarImageUserControl"
             x:DataType="vm:SimilarImageViewModel">
    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,4">
            <TextBox Grid.Column="0" Text="{Binding SearchPath}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectFolderCommand}" Margin="6,0,0,0" />
            <ToggleSwitch Grid.Column="2" Content="Subfolder" IsChecked="{Binding SubFolder}" Margin="12,0,0,0" />
            <Button Grid.Column="3" Content="Search" Command="{Binding SearchCommand}" Margin="6,0,0,0" />
            <Button Grid.Column="4" Content="Stop" Command="{Binding StopSearchCommand}" Margin="6,0,0,0" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <CheckBox Content="Detect crops and edits (DINOv2)" IsChecked="{Binding UseSemantic}" />
            <NumericUpDown Value="{Binding SemanticThreshold}" Minimum="0.5" Maximum="1"
                           Increment="0.01" FormatString="0.00" Width="90"
                           IsEnabled="{Binding UseSemantic}" Margin="6,0,12,0" />
            <CheckBox Content="Suggest a keeper by quality" IsChecked="{Binding UseKeeper}" />
            <CheckBox Content="Use DBCNN quality model" IsChecked="{Binding UseKeeperModel}"
                      IsEnabled="{Binding UseKeeper}" Margin="12,0,0,0" />
            <CheckBox Content="Allow model download" IsChecked="{Binding AllowModelDownload}"
                      IsVisible="{Binding NeedsModelDownload}" Margin="12,0,0,0" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,4" ColumnDefinitions="Auto,120,Auto,*,Auto,2*">
            <TextBlock Grid.Column="0" Text="Min bytes" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding MinimumFileSizeText}" PlaceholderText="10240" />
            <TextBlock Grid.Column="2" Text="Extensions" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Grid.Column="3" Text="{Binding FileExtensions}" PlaceholderText=".jpg,.png" />
            <TextBlock Grid.Column="4" Text="Exclude folders" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Grid.Column="5" Text="{Binding ExcludedFolders}" PlaceholderText="C:\Temp" />
        </Grid>

        <ProgressBar Classes="pageProgress" Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />

        <Grid Grid.Row="4" ColumnDefinitions="1*,2*" IsVisible="{Binding Finished}">
            <ListBox Grid.Column="0" Name="SimilarGroups" BorderThickness="1" Margin="0,0,6,0"
                     ItemsSource="{Binding DuplicateCaseItems}" SelectedItem="{Binding DuplicateCase}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateCaseViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="96" Height="72" Margin="0,0,8,0"
                                    Background="#22808080" CornerRadius="4" ClipToBounds="True">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="6,0,0,4">
                    <TextBlock Text="{Binding DuplicateCase.KindText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DuplicateCase.Detail}" />
                    <TextBlock Text="{Binding DuplicateCase.ReclaimableSizeText}" />
                    <TextBlock Text="{Binding DuplicateCase.KeeperText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DuplicateCase.SimilarityText}" />
                    <TextBlock Text="{Binding DuplicateCase.KeeperQualityText}" />
                </StackPanel>

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Height="180" Margin="6,0,0,4">
                    <DockPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock DockPanel.Dock="Top" Text="Keeper" FontSize="12" FontWeight="SemiBold" />
                        <Border BorderThickness="1" CornerRadius="4" Background="#11808080">
                            <Image Source="{Binding DuplicateCase.KeeperPreview}" Stretch="Uniform" />
                        </Border>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Selected" FontSize="12" FontWeight="SemiBold" />
                        <Border BorderThickness="1" CornerRadius="4" Background="#11808080">
                            <Image Source="{Binding DuplicateCase.SelectedPreview}" Stretch="Uniform" />
                        </Border>
                    </DockPanel>
                </Grid>

                <ListBox Name="SimilarImageItems" BorderThickness="1" ItemsSource="{Binding DuplicateCase.Files}"
                         SelectedItem="{Binding DuplicateCase.SelectedFile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DuplicateCaseItemViewModel">
                            <views:DuplicateCaseItemView />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <controls:AutoScrollTextBox AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap"
                                    Name="SearchLog" FontFamily="monospace"
                                    IsVisible="{Binding !Finished}" Grid.Row="4" Grid.RowSpan="3"
                                    Text="{Binding SearchLog}" />

        <Expander Grid.Row="5" Header="Models and caches" IsExpanded="False" Margin="0,4,0,0">
            <StackPanel Spacing="4" Margin="4">
                <TextBlock Text="{Binding CacheSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ModelDirectory}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="Refresh" Command="{Binding RefreshCacheSummaryCommand}" Margin="0,0,6,0" />
                    <Button Content="Prune" Command="{Binding PruneCachesCommand}" Margin="0,0,6,0" />
                    <Button Content="Clear caches" Command="{Binding ClearCachesCommand}" Margin="0,0,6,0" />
                    <Button Content="Open model folder" Command="{Binding OpenModelFolderCommand}" />
                </WrapPanel>
                <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                           Text="Clear removes cached hashes, embeddings and quality scores. Downloaded models are kept." />
            </StackPanel>
        </Expander>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,6,0,0">
            <TextBlock Grid.Column="0" Text="{Binding Summary}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <CheckBox Grid.Column="1" Content="Dry run" IsChecked="{Binding DryRun}" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="Delete selected group"
                    Command="{Binding DeleteSelectedNonKeepersCommand}" Margin="6,0,0,0" />
            <Button Grid.Column="3" Content="Delete all groups"
                    Command="{Binding DeleteNonKeepersCommand}" Margin="6,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
