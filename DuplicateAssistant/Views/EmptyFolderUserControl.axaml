<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DuplicateAssistant.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DuplicateAssistant.Views.EmptyFolderUserControl"
             x:DataType="vm:EmptyFolderViewModel">
    <Grid Margin="8" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchPath}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectFolderCommand}" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="Scan" Command="{Binding ScanCommand}" Margin="6,0,0,0" />
            <Button Grid.Column="3" Content="Stop" Command="{Binding StopCommand}" Margin="6,0,0,0" />
        </Grid>

        <ProgressBar Classes="pageProgress" Grid.Row="1" IsIndeterminate="{Binding IsBusy}" />

        <ListBox Grid.Row="2" BorderThickness="1" ItemsSource="{Binding EmptyDirectories}" FontFamily="monospace" />

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                       Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
            <Button Grid.Column="1" Content="Delete empty folders" Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding HasResults}" />
        </Grid>
    </Grid>
</UserControl>
