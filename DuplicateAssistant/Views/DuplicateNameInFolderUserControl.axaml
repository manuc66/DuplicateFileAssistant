<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DuplicateAssistant.ViewModels"
             xmlns:controls="clr-namespace:DuplicateAssistant.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DuplicateAssistant.Views.DuplicateNameInFolderUserControl"
             x:DataType="vm:DuplicateNameInFolderViewModel">
    <Design.DataContext>
        <vm:DuplicateNameInFolderViewModel/>
    </Design.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" Grid.Column="0" Name="FolderPath" VerticalAlignment="Center" Text="{Binding Path=SearchPath}"/>
        <Button Content="Browse" Grid.Row="0" Grid.Column="1" Command="{Binding SelectFolderCommand}" HorizontalAlignment="Right"/>
        <ToggleSwitch Content="Subfolder" IsChecked="{Binding SubFolder}" Grid.Row="0" Grid.Column="2"></ToggleSwitch>
        <Button Content="Search" Grid.Row="0" Grid.Column="3" Command="{Binding SearchCommand}" HorizontalAlignment="Right"/>
        <Button Content="Stop" Grid.Row="0" Grid.Column="4" Command="{Binding StopSearchCommand}" HorizontalAlignment="Right"/>
        
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Min bytes" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding MinimumFileSizeText}" PlaceholderText="0" />
            <TextBlock Grid.Column="2" Text="Extensions" VerticalAlignment="Center" Margin="12,0,6,0" />
            <controls:ExtensionPicker Grid.Column="3" DataContext="{Binding ExtensionSelection}" />
            <TextBlock Grid.Column="4" Text="Exclude folders" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Grid.Column="5" Text="{Binding ExcludedFolders}" PlaceholderText="C:\Temp" />
        </Grid>

        <ProgressBar Classes="pageProgress" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"/>
        
        <ListBox IsVisible="{Binding Finished}" BorderThickness="1" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Name="DuplicateCases"
                 x:Name="DuplicateCases" SelectedItem="{Binding DuplicateCase}" ItemsSource="{Binding DuplicateCaseItems}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DuplicateCaseViewModel">
                    <TextBlock Text="{Binding Path=Name}"></TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel IsVisible="{Binding Finished}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="4">
                <TextBlock Grid.Column="0" Text="{Binding DuplicateCase.ReclaimableSizeText}" />
                <TextBlock Grid.Column="1" Text="{Binding DuplicateCase.KeeperText}" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DuplicateCase.KeeperText}" />
            </Grid>
            <ListBox BorderThickness="1"
                     Name="DuplicateItems"
                     ItemsSource="{Binding DuplicateCase.Files}">
            </ListBox>
        </DockPanel>
        <controls:AutoScrollTextBox AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" Name="SearchLog" FontFamily="monospace" IsVisible="{Binding !Finished}" Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding SearchLog}" >

        </controls:AutoScrollTextBox>
    </Grid>
</UserControl>