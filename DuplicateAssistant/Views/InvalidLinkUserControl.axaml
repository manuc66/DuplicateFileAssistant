<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DuplicateAssistant.ViewModels"
             xmlns:fileCompare="using:FileCompare"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DuplicateAssistant.Views.InvalidLinkUserControl"
             x:DataType="vm:InvalidLinkViewModel">
    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchPath}" />
            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectFolderCommand}" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="Scan" Command="{Binding ScanCommand}" Margin="6,0,0,0" />
            <Button Grid.Column="3" Content="Stop" Command="{Binding StopCommand}" Margin="6,0,0,0" />
        </Grid>

        <CheckBox Grid.Row="1" Content="Dry run" IsChecked="{Binding DryRun}" Margin="0,0,0,4" />

        <ProgressBar Classes="pageProgress" Grid.Row="2" IsIndeterminate="{Binding IsBusy}" />

        <ListBox Grid.Row="3" BorderThickness="1" ItemsSource="{Binding Links}"
                 SelectedItem="{Binding SelectedLink}" FontFamily="monospace">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="fileCompare:InvalidSymbolicLink">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Path}" />
                        <TextBlock Text="=>" Opacity="0.6" />
                        <TextBlock Text="{Binding Target}" Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                       Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
            <Button Grid.Column="1" Content="Delete selected" Command="{Binding DeleteSelectedCommand}" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="Delete all" Command="{Binding DeleteAllCommand}" Margin="6,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
