<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DuplicateAssistant.ViewModels"
             xmlns:fileCompare="using:FileCompare"
             xmlns:controls="clr-namespace:DuplicateAssistant.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DuplicateAssistant.Views.DeleteIfElsewhereUserControl"
             x:DataType="vm:DeleteIfElsewhereViewModel">
    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Source" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding SourcePath}" />
            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseSourceCommand}" Margin="6,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Elsewhere" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding OtherPath}" />
            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseOtherCommand}" Margin="6,0,0,0" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Hash" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding HashAlgorithms}" SelectedItem="{Binding HashAlgorithm}" />
            <Button Grid.Column="2" Content="Scan" Command="{Binding ScanCommand}" Margin="12,0,0,0" />
            <CheckBox Grid.Column="3" Content="Dry run" IsChecked="{Binding DryRun}" Margin="12,0,0,0" />
        </Grid>

        <controls:OperationBar Grid.Row="3" />

        <ListBox Grid.Row="4" BorderThickness="1" ItemsSource="{Binding Duplicates}" FontFamily="monospace">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="fileCompare:CrossFolderDuplicate">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Source.Path}" />
                        <TextBlock Text="{Binding Source.SizeText}" Opacity="0.6" />
                        <TextBlock Text="=>" Opacity="0.6" />
                        <TextBlock Text="{Binding Other.Path}" />
                        <TextBlock Text="{Binding Other.SizeText}" Opacity="0.6" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="5" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                       Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
            <Button Grid.Column="1" Content="Move to trash" Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding HasResults}" />
        </Grid>
    </Grid>
</UserControl>
