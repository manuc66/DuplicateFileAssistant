<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DuplicateAssistant.ViewModels"
             xmlns:controls="clr-namespace:DuplicateAssistant.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DuplicateAssistant.Views.DuplicateContentInFolderUserControl"
             x:DataType="vm:DuplicateContentInFolderViewModel">
    <Design.DataContext>
        <vm:DuplicateContentInFolderViewModel/>
    </Design.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBox Grid.Column="0" Name="FolderPath" VerticalAlignment="Center" Text="{Binding Path=SearchPath}" />
            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectFolderCommand}"
                    HorizontalAlignment="Right" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding HashAlgorithms}" SelectedItem="{Binding HashAlgorithm }" Width="100" VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ToggleSwitch Grid.Column="3" Content="Subfolder" IsChecked="{Binding SubFolder}"></ToggleSwitch>
            <Button Grid.Column="4" Content="Search" Command="{Binding SearchCommand}" HorizontalAlignment="Right" />
            <Button Grid.Column="5" Content="Stop" Command="{Binding StopSearchCommand}" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Min bytes" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding MinimumFileSizeText}" PlaceholderText="0" />
            <TextBlock Grid.Column="2" Text="Extensions" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Grid.Column="3" Text="{Binding FileExtensions}" PlaceholderText=".jpg,.png" />
            <TextBlock Grid.Column="4" Text="Exclude folders" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Grid.Column="5" Text="{Binding ExcludedFolders}" PlaceholderText="C:\Temp" />
        </Grid>

        <ProgressBar Grid.Row="2" Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />

        <ListBox IsVisible="{Binding Finished}" BorderThickness="1" Grid.Row="3" Grid.Column="0" Name="DuplicateCases"
                 x:Name="DuplicateCases" SelectedItem="{Binding DuplicateCase}" ItemsSource="{Binding DuplicateCaseItems}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DuplicateCaseViewModel">
                    <TextBlock Text="{Binding Path=Name}"></TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel IsVisible="{Binding Finished}" Grid.Row="4" Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="4">
                <TextBlock Text="{Binding DuplicateCase.ReclaimableSizeText}" />
                <TextBlock Text="{Binding DuplicateCase.KeeperText}" />
            </StackPanel>
            <ListBox BorderThickness="1"
                     Name="DuplicateItems"
                     ItemsSource="{Binding DuplicateCase.Files}">
            </ListBox>
        </DockPanel>
        <controls:AutoScrollTextBox AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" Name="SearchLog" FontFamily="monospace"
                                    IsVisible="{Binding !Finished}" Grid.Row="3" Grid.RowSpan="2" Grid.Column="0"
                                    Text="{Binding SearchLog}">

        </controls:AutoScrollTextBox>
    </Grid>
</UserControl>